{
  "name": "elite-client",
  "version": "1.0.0",
  "scripts": {
    "start": "ng serve client-web",
    "start:admin": "ng serve admin-portal --port 4300",
    "build:web": "ng build client-web --configuration production",
    "build:admin": "ng build admin-portal --configuration production && node scripts/generate-pos-precache.mjs",
    "build:all": "npm run build:web && npm run build:admin",
    "test:e2e": "playwright test",
    "test:e2e:auth": "playwright test --config=playwright.auth.config.ts",
    "lint": "ng lint",
    "test": "ng test",
    "test:hero": "playwright test --config=playwright.hero.config.ts",
    "test:sku": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/variant-sku.test.ts",
    "test:stocktake-csv": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/stocktake-csv.test.ts",
    "test:pos-printing": "node --test test/pos-printing.test.mjs",
    "serve:ssr:client-web": "node dist/client-web/server/server.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.0.7",
    "@angular/common": "22.0.7",
    "@angular/compiler": "22.0.7",
    "@angular/core": "22.0.7",
    "@angular/forms": "22.0.7",
    "@angular/platform-browser": "22.0.7",
    "@angular/platform-browser-dynamic": "22.0.7",
    "@angular/platform-server": "22.0.7",
    "@angular/router": "22.0.7",
    "@angular/ssr": "22.0.7",
    "express": "^5.1.0",
    "jsbarcode": "^3.12.3",
    "qz-tray": "^2.2.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.6.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.0.7",
    "@angular/cli": "22.0.7",
    "@angular/compiler-cli": "22.0.7",
    "@playwright/test": "^1.53.2",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "esbuild": "^0.28.1",
    "typescript": "~6.0.3"
  }
}
