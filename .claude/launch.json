{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "server",
      "port": 3000
    },
    {
      "name": "client-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start"],
      "cwd": "client",
      "port": 4200
    },
    {
      "name": "client-web-csr",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["ng", "serve", "client-web", "--configuration", "csr", "--port", "4210"],
      "cwd": "client",
      "port": 4210
    },
    {
      "name": "admin-portal",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start:admin"],
      "cwd": "client",
      "port": 4300
    }
  ]
}
