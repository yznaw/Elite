{
  "name": "elite-server",
  "version": "1.0.0",
  "description": "Elite API Server",
  "main": "index.js",
  "engines": {
    "node": "^22.0.0"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "NODE_ENV=test node --test --test-concurrency=1 test/*.test.js",
    "db:migrate": "psql \"$DATABASE_URL\" -f db/migrations/001_initial_schema.sql",
    "db:seed": "node db/seed.js",
    "db:seed:admins": "node db/seed-admins.js",
    "media:backfill-variants": "node scripts/backfill-image-variants.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^9.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.0",
    "express-session": "^1.18.0",
    "helmet": "^8.3.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.3",
    "pg": "^8.20.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "pino-pretty": "^13.1.3"
  },
  "overrides": {
    "body-parser": "^1.20.6",
    "qs": "^6.15.3"
  }
}
